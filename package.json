{
  "name": "watch-mcp",
  "version": "0.1.0",
  "description": "Let Claude watch videos: an MCP server that turns an MP4/MOV/MKV/WebM into timestamped storyboards, drill-down frames and a local Whisper transcript.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "video",
    "ffmpeg",
    "whisper",
    "storyboard",
    "screen-recording"
  ],
  "author": "Maxence Foulon",
  "license": "MIT",
  "type": "module",
  "bin": {
    "watch-mcp": "dist/cli.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 'test/**/*.test.ts'",
    "start": "node dist/cli.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@fugood/whisper.node": "^1.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ffmpeg-static": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^7.0.2"
  }
}
