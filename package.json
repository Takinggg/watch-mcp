{
  "name": "watch-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude, Codex and Cursor watch videos and screen recordings: timestamped storyboards, zoom and full-resolution frames, and a local Whisper transcript.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-desktop",
    "codex",
    "cursor",
    "ai-agents",
    "video",
    "video-understanding",
    "screen-recording",
    "screen-recorder",
    "storyboard",
    "keyframes",
    "transcription",
    "whisper",
    "ffmpeg",
    "macos",
    "local-first"
  ],
  "homepage": "https://github.com/Takinggg/watch-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takinggg/watch-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Takinggg/watch-mcp/issues"
  },
  "mcpName": "io.github.Takinggg/watch-mcp",
  "author": "Maxence Foulon",
  "license": "MIT",
  "type": "module",
  "bin": {
    "watch-mcp": "dist/cli.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 'test/**/*.test.ts'",
    "start": "node dist/cli.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@fugood/whisper.node": "^1.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ffmpeg-static": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^7.0.2"
  }
}
